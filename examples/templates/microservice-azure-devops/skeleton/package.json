{%- if values.language == 'nodejs' %}
{
  "name": "{{ values.component_id }}",
  "version": "1.0.0",
  "description": "{{ values.description }}",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "microservice",
    "{{ values.language }}",
    "{{ values.framework }}"
  ],
  "author": "{{ values.owner }}",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.18.2",
    {%- if values.enableObservability %}
    "prom-client": "^15.1.0",
    {%- endif %}
    {%- if values.database == 'postgresql' %}
    "pg": "^8.11.3",
    {%- elif values.database == 'mongodb' %}
    "mongodb": "^6.3.0",
    {%- elif values.database == 'redis' %}
    "redis": "^4.6.12",
    {%- endif %}
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
{%- endif %}
